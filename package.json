{
  "name": "twilio-homekit-intercom",
  "version": "0.1.0",
  "description": "HomeKit-compatible apartment intercom via Twilio media streams",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --check server.js homekit.js twilio-api.js src/core/*.js",
    "test": "DOTENV_CONFIG_PATH=/dev/null node --test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atdr/twilio-homekit-intercom.git"
  },
  "homepage": "https://github.com/atdr/twilio-homekit-intercom",
  "bugs": {
    "url": "https://github.com/atdr/twilio-homekit-intercom/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "hap-nodejs": "^0.14.2",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^6.0.2",
    "websocket": "^1.0.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/websocket": "^1.0.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  }
}
