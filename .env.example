# ── Twilio ────────────────────────────────────────────────────────────────────
# From https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number that receives intercom calls (E.164 format)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── HAP-NodeJS ────────────────────────────────────────────────────────────────
# MAC-style address — must be unique on your LAN.
# Generate once: node -e "const c=require('crypto');const b=c.randomBytes(6);console.log([...b].map(x=>x.toString(16).padStart(2,'0').toUpperCase()).join(':'))"
HAP_USERNAME=AA:BB:CC:DD:EE:FF

# 8-digit HomeKit pairing code (shown in Home app "Add Accessory" flow)
# Format: XXX-XX-XXX  (digits only, dashes included)
HAP_PINCODE=031-45-154

# UDP port HAP-NodeJS advertises over mDNS — must be open in your firewall
HAP_PORT=47129
