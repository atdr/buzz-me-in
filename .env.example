# ── Twilio ────────────────────────────────────────────────────────────────────
# From https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number that receives intercom calls (E.164 format)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# Your Cloudflare Tunnel hostname — used to build the wss:// URL in TwiML
# e.g. intercom.yourdomain.com
TUNNEL_HOSTNAME=intercom.yourdomain.com

# Base URL Twilio signs against for /twiml webhook validation.
# Optional: defaults to https://{TUNNEL_HOSTNAME}
# Set this if your externally visible webhook URL differs.
#TWILIO_WEBHOOK_BASE_URL=https://intercom.yourdomain.com

# HMAC secret used to sign one-time WebSocket stream tokens embedded in TwiML.
# Must be at least 32 chars.
STREAM_AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars

# Bearer token required for GET /status.
# Must be at least 16 chars.
STATUS_API_TOKEN=replace_with_a_long_random_token_min_16_chars

# Session/stream reliability tuning
# Reap an active call if no activity is seen for this many seconds.
CALL_SESSION_STALE_SEC=900
# Reject incoming WS JSON frames larger than this many bytes.
WS_MAX_MESSAGE_BYTES=4096
# Reject decoded Twilio media payload chunks larger than this many bytes.
TWILIO_MEDIA_PAYLOAD_MAX_BYTES=512
# DTMF sequence Twilio plays when HomeKit unlocks. "w" inserts a 0.5 s pause.
# Default is w9w: wait briefly after leaving <Connect><Stream>, play 9,
# then wait briefly before reconnecting the media stream.
TWILIO_UNLOCK_DIGITS=w9w
# Grace period for SIGINT/SIGTERM graceful shutdown before forced exit.
SHUTDOWN_GRACE_MS=10000

# Logging
# LOG_LEVEL controls minimum emitted level: debug | info | warn | error
# Default is info when unset/invalid.
#LOG_LEVEL=info
# Set to 1 for indented JSON logs during local development.
#LOG_PRETTY=1

# ── HAP-NodeJS ────────────────────────────────────────────────────────────────
# MAC-style address — must be unique on your LAN.
# Generate once: node -e "const c=require('crypto');const b=c.randomBytes(6);console.log([...b].map(x=>x.toString(16).padStart(2,'0').toUpperCase()).join(':'))"
HAP_USERNAME=AA:BB:CC:DD:EE:FF

# 8-digit HomeKit pairing code (shown in Home app "Add Accessory" flow)
# Format: XXX-XX-XXX  (digits only, dashes included)
# Generate once: node -e "const r=()=>Math.floor(Math.random()*1000).toString().padStart(3,'0');console.log(r()+'-'+Math.floor(Math.random()*100).toString().padStart(2,'0')+'-'+r())"
HAP_PINCODE=XXX-XX-XXX

# UDP port HAP-NodeJS advertises over mDNS — must be open in your firewall
HAP_PORT=47129
